{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "订单履约留痕",
  "description": "订单履约时固定买家实际看到的页面版本与所用采购批次；记录实际发货主体、发货仓与追溯码。低价与异地发货仅作观察事实，不单独构成风险信号。买家字段使用平台内部假名标识，不含真实身份信息。",
  "type": "object",
  "required": ["orders"],
  "properties": {
    "orders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "order_id",
          "listing_id",
          "locked_version_id",
          "locked_batch_no",
          "buyer_ref",
          "fulfilled_at",
          "page_view",
          "shipment",
          "trace_codes",
          "observations"
        ],
        "properties": {
          "order_id": { "type": "string", "minLength": 1 },
          "listing_id": { "type": "string", "minLength": 1 },
          "locked_version_id": { "type": "string", "minLength": 1 },
          "locked_batch_no": { "type": "string", "minLength": 1 },
          "buyer_ref": { "type": "string", "minLength": 1 },
          "fulfilled_at": { "type": "string", "format": "date-time" },
          "page_view": {
            "type": "object",
            "required": ["snapshot_id", "listing_hash", "price"],
            "properties": {
              "snapshot_id": { "type": "string", "minLength": 1 },
              "listing_hash": { "type": "string", "minLength": 1 },
              "price": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "shipment": {
            "type": "object",
            "required": ["shipping_entity_id", "warehouse_address", "shipped_at"],
            "properties": {
              "shipping_entity_id": { "type": "string", "minLength": 1 },
              "warehouse_address": { "type": "string", "minLength": 1 },
              "shipped_at": { "type": "string", "format": "date-time" },
              "cold_chain_record": {
                "type": "object",
                "required": ["kept_in_range", "max_celsius", "min_celsius"],
                "properties": {
                  "kept_in_range": { "type": "boolean" },
                  "min_celsius": { "type": "number" },
                  "max_celsius": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "trace_codes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "observations": {
            "type": "object",
            "required": ["low_price", "cross_region"],
            "description": "观察项：低价或异地发货本身不触发处置，仅用于与报备事实比对。",
            "properties": {
              "low_price": { "type": "boolean" },
              "cross_region": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
